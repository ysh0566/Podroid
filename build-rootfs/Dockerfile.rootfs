# build-rootfs/Dockerfile.rootfs

# ── Stage 1: cross-compile podroid-vsock-agent (musl-static aarch64) ────────
# Uses qemu-user under the hood — no separate cross-toolchain needed.
FROM --platform=linux/arm64 alpine:3.24 AS vsock-builder
RUN apk add --no-cache musl-dev gcc make linux-headers
WORKDIR /work
COPY vsock-agent /work/vsock-agent
RUN cd /work/vsock-agent && make CC=gcc
COPY host-bridge /work/host-bridge
RUN cd /work/host-bridge && make CC=gcc
COPY overlay-normalize /work/overlay-normalize
RUN cd /work/overlay-normalize && make CC=gcc

# ── Stage 2: build the Alpine rootfs squashfs ───────────────────────────────
FROM alpine:3.24 AS builder

ARG ALPINE_RELEASE=3.24.2
ARG ALPINE_ARCH=aarch64

RUN apk add --no-cache curl squashfs-tools tar openssl libcap-utils

WORKDIR /work
RUN curl -L -o minirootfs.tar.gz \
    "https://dl-cdn.alpinelinux.org/alpine/v${ALPINE_RELEASE%.*}/releases/${ALPINE_ARCH}/alpine-minirootfs-${ALPINE_RELEASE}-${ALPINE_ARCH}.tar.gz" \
 && mkdir rootfs \
 && tar -xzf minirootfs.tar.gz -C rootfs \
 && rm minirootfs.tar.gz

# Pinned upstream release; verify the archive before adding executable code.
# Source and license: https://github.com/SagerNet/sing-box/tree/v1.14.4
ARG SING_BOX_VERSION=1.14.4
ARG SING_BOX_SHA256=b95e25f921dc5e17a4cf13327243d1177642c7e35425bf5372862c477c359f56
RUN test "$ALPINE_ARCH" = aarch64 \
 && curl -fL --retry 3 -o /work/sing-box.tar.gz \
    "https://github.com/SagerNet/sing-box/releases/download/v${SING_BOX_VERSION}/sing-box-${SING_BOX_VERSION}-linux-arm64-musl.tar.gz" \
 && echo "${SING_BOX_SHA256}  /work/sing-box.tar.gz" | sha256sum -c - \
 && tar -xzf /work/sing-box.tar.gz -C /work \
 && mkdir -p /work/rootfs/usr/local/bin /work/rootfs/usr/share/licenses/sing-box \
 && cp /work/sing-box-${SING_BOX_VERSION}-linux-arm64-musl/sing-box /work/rootfs/usr/local/bin/ \
 && cp /work/sing-box-${SING_BOX_VERSION}-linux-arm64-musl/LICENSE /work/rootfs/usr/share/licenses/sing-box/ \
 && rm -rf /work/sing-box.tar.gz /work/sing-box-${SING_BOX_VERSION}-linux-arm64-musl

# Pull in the vsock-agent binary built in stage 1.
COPY --from=vsock-builder /work/vsock-agent/podroid-vsock-agent /work/rootfs/usr/local/bin/podroid-vsock-agent
COPY --from=vsock-builder /work/host-bridge/podroid-hostd /work/rootfs/usr/local/bin/podroid-hostd
COPY --from=vsock-builder /work/overlay-normalize/podroid-overlay-normalize /work/rootfs/usr/local/bin/podroid-overlay-normalize

ARG SYSTEM_VERSION=0
ENV SYSTEM_VERSION=${SYSTEM_VERSION}

ENV ALPINE_VERSION=${ALPINE_RELEASE}
COPY files /work/files
# Staged by build_rootfs() in build-all.sh (docs/ lives outside this build
# context); served in-guest by /usr/local/bin/podroid-docs.
COPY docs-guide /work/docs-guide
COPY build-rootfs.sh /work/build-rootfs.sh
RUN chmod +x /work/build-rootfs.sh && /work/build-rootfs.sh

RUN mksquashfs /work/rootfs /work/alpine-rootfs.squashfs \
    -comp zstd -Xcompression-level 19 -all-root -noappend
# (No -no-xattrs: rootless podman's newuidmap/newgidmap need their
# file capabilities preserved; they're stored as security.capability xattr.)

FROM scratch AS export
COPY --from=builder /work/alpine-rootfs.squashfs /alpine-rootfs.squashfs
